modules = ["nodejs-24", "javascript", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["notion:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"
packages = ["pstree", "eas-cli"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_POSTHOG_TOKEN = "phc_ujzCizkg5fppua6PwidhQAuhegBrVQ3cm78GP9mmr4S5"
EXPO_PUBLIC_POSTHOG_HOST = "https://us.i.posthog.com"
EMBEDDING_SERVICE_URL = "http://localhost:8000"

[objectStorage]
defaultBucketID = "replit-objstore-4b6c9fed-f757-4bf7-8128-d80078b0642f"
