modules = ["nodejs-24", "javascript", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Publish iOS (App Store)"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash /home/runner/workspace/artifacts/friction/scripts/publish-ios.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Submit iOS (App Store)"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash /home/runner/workspace/artifacts/friction/scripts/submit-ios.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[[workflows.workflow]]
name = "artifacts/friction: expo"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/friction"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/friction run dev"
cwd = "./artifacts/friction"
waitForPort = 21672
ensurePreviewReachable = "/status"
router = "expo-domain"

[workflows.workflow.tasks.env]
PORT = "21672"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 3001
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "3001"

[[workflows.workflow]]
name = "Publish iOS (Dev Client)"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash /home/runner/workspace/artifacts/friction/scripts/publish-dev.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Preview Activate"

[[workflows.workflow]]
name = "Preview Activate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/friction && pnpm dev:tunnel"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["notion:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"
packages = ["pstree", "eas-cli"]

[userenv]

[userenv.shared]
EXPO_PUBLIC_POSTHOG_TOKEN = "phc_ujzCizkg5fppua6PwidhQAuhegBrVQ3cm78GP9mmr4S5"
EXPO_PUBLIC_POSTHOG_HOST = "https://us.i.posthog.com"
EMBEDDING_SERVICE_URL = "http://localhost:8000"

[objectStorage]
defaultBucketID = "replit-objstore-4b6c9fed-f757-4bf7-8128-d80078b0642f"
