{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-cli/schema.json",
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "test": {
      "environment": "production",
      "env": {
        "APP_RELEASE_TRACK": "production"
      },
      "ios": {
        "distribution": "store",
        "credentialsSource": "remote",
        "autoIncrement": true
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote",
        "autoIncrement": true
      }
    },
    "preview": {
      "env": {
        "APP_RELEASE_TRACK": "preview"
      },
      "ios": {
        "distribution": "store",
        "credentialsSource": "remote",
        "autoIncrement": true
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote",
        "autoIncrement": true
      }
    },
    "development": {
      "developmentClient": true,
      "env": {
        "APP_VARIANT": "development",
        "APP_RELEASE_TRACK": "development"
      },
      "ios": {
        "distribution": "store",
        "credentialsSource": "remote",
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "test": {
      "ios": {
        "ascAppId": "6795505833"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6795505833"
      }
    },
    "development": {
      "ios": {
        "ascAppId": "6801383039"
      }
    }
  }
}
