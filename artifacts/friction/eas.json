{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-cli/schema.json",
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "production": {
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      },
      "ios": {
        "distribution": "store",
        "credentialsSource": "remote",
        "autoIncrement": true
      }
    },
    "preview": {
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      },
      "ios": {
        "distribution": "store",
        "credentialsSource": "remote",
        "autoIncrement": true
      }
    },
    "development": {
      "developmentClient": true,
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      },
      "ios": {
        "distribution": "store",
        "credentialsSource": "remote",
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6795505833",
        "ascApiKeyPath": "/tmp/asc_api_key.p8",
        "ascApiKeyId": "$APP_STORE_CONNECT_KEY_ID",
        "ascApiKeyIssuerId": "$APP_STORE_CONNECT_ISSUER_ID"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6795505833",
        "ascApiKeyPath": "/tmp/asc_api_key.p8",
        "ascApiKeyId": "$APP_STORE_CONNECT_KEY_ID",
        "ascApiKeyIssuerId": "$APP_STORE_CONNECT_ISSUER_ID"
      }
    },
    "development": {
      "ios": {
        "ascAppId": "6795505833",
        "ascApiKeyPath": "/tmp/asc_api_key.p8",
        "ascApiKeyId": "$APP_STORE_CONNECT_KEY_ID",
        "ascApiKeyIssuerId": "$APP_STORE_CONNECT_ISSUER_ID"
      }
    }
  }
}
